      ]
    },
    {
      "name": "profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profile\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"daily_kcal\" REAL NOT NULL, \"protein_g\" REAL NOT NULL, \"fiber_g\" REAL NOT NULL, \"sugar_limit_pct\" REAL NOT NULL, \"saturated_limit_pct\" REAL NOT NULL, \"salt_limit_mg\" REAL NOT NULL, \"weight_kg\" REAL NOT NULL, \"height_cm\" REAL NOT NULL);"
        }
      ]
    },
    {
      "name": "activities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activities\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"preset_key\" TEXT NULL, \"name\" TEXT NOT NULL, \"kcal_per_unit\" INTEGER NOT NULL, \"unit_label\" TEXT NOT NULL, \"is_duration_based\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_duration_based\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "activity_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activity_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"activity_id\" INTEGER NOT NULL UNIQUE REFERENCES activities (id) ON DELETE CASCADE, \"amount\" INTEGER NOT NULL);"
